{
  "name": "@0xnookie/injex",
  "mcpName": "io.github.0xnookie/injex",
  "version": "1.5.1",
  "description": "Find, remove and decode hidden text: a browser extension (encoders, universal decoder, steganography, hidden-text scanner, paste guard) and a CLI, MCP server, pre-commit hook and GitHub Action that find hidden instructions in files, PDFs and Word documents.",
  "keywords": [
    "prompt-injection",
    "llm-security",
    "ai-security",
    "hidden-text",
    "unicode",
    "steganography",
    "invisible-characters",
    "trojan-source",
    "pdf",
    "docx",
    "mcp",
    "sarif",
    "github-action",
    "pre-commit",
    "red-team"
  ],
  "type": "module",
  "bin": {
    "injex": "cli/injex.mjs"
  },
  "files": [
    "cli/",
    "src/core/",
    "src/data/",
    "src/transforms/",
    "vendor/gpt-tokenizer/",
    "contrib/",
    "action.yml",
    "server.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!**/__pycache__/",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "scan": "node cli/injex.mjs scan",
    "sync:transforms": "node tools/sync-transforms.mjs",
    "build:emoji": "node tools/build-emoji-data.mjs",
    "build:unicode": "node tools/build-unicode-data.mjs",
    "build:firefox": "node tools/build-firefox.mjs --zip dist/injex-firefox.zip"
  },
  "homepage": "https://github.com/0xnookie/injex#readme",
  "bugs": "https://github.com/0xnookie/injex/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnookie/injex.git"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
